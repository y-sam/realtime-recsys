# --- broker ---
KAFKA_BOOTSTRAP=redpanda:9092
EVENTS_TOPIC=user_events

# --- simulator ---
EVENTS_PER_SECOND=8
N_USERS=5000
N_ITEMS=2000
NEW_USER_RATE=0.05
BASE_CTR=0.08
FATIGUE_DECAY=0.55
REWARD_DELAY_S=45

# --- postgres (offline store + Airflow metadata) ---
POSTGRES_USER=rtrec
POSTGRES_PASSWORD=rtrec
POSTGRES_DB=rtrec

# --- postgres sink ---
SINK_BATCH_SIZE=500
SINK_RETENTION_DAYS=30

# --- redis (online store) ---
REDIS_URL=redis://redis:6379/0

# --- api ---
# Inference (LightGBM + PyTorch) is synchronous and blocks uvicorn's event loop,
# so with 1 worker throughput is flat regardless of concurrency (~37 req/s measured
# on a 4-vCPU host). Set to the host's vCPU count in production -- measured ~2.6x
# throughput and p50 257ms->100ms at c=10 going from 1 to 4 workers on that host.
# Default of 1 keeps local dev single-process (easier logs, less RAM).
UVICORN_WORKERS=1
