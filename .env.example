# --- broker ---
KAFKA_BOOTSTRAP=redpanda:9092
EVENTS_TOPIC=user_events

# --- simulator ---
EVENTS_PER_SECOND=8
N_USERS=5000
N_ITEMS=2000
NEW_USER_RATE=0.05
BASE_CTR=0.08
FATIGUE_DECAY=0.55
REWARD_DELAY_S=45

# --- postgres (offline store + Airflow metadata) ---
POSTGRES_USER=rtrec
POSTGRES_PASSWORD=rtrec
POSTGRES_DB=rtrec

# --- redis (online store) ---
REDIS_URL=redis://redis:6379/0
